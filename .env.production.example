# نمونه‌ی .env برای سرور یک مکتب (DEPLOYMENT.md). این فایل را به .env کاپی و مقدارها را پر کنید.
# هر مکتب .env، پایگاه داده، storage و backups خودش را دارد. .env هرگز در git نمی‌رود.

APP_NAME="سیستم مدیریت مکتب"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# آدرس سرور در شبکه‌ی داخلی مکتب، مثلاً http://192.168.1.10
APP_URL=http://192.168.1.10

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=60

# پایگاه داده‌ی جدای همین مکتب و کاربر محدود به همان پایگاه داده (نه root؛ DEPLOYMENT.md بخش امنیت)
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=maktab
DB_USERNAME=maktab_app
DB_PASSWORD=

# session در پایگاه داده، رمزنگاری‌شده؛ با بستن مرورگر یا ۸ ساعت بی‌کاری ختم می‌شود
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_EXPIRE_ON_CLOSE=true
SESSION_PATH=/
SESSION_DOMAIN=null
# اگر چند مکتب روی یک کامپیوتر نصب است، برای هر کدام نام جدا
SESSION_COOKIE=maktab_session
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
MAIL_MAILER=log

# پشتیبان (config/school.php)
BACKUP_KEEP=12
BACKUP_EVERY_DAYS=30
# پوشه‌ی دوم برای کاپی پشتیبان، مثلاً فلش: E:\maktab-backup
BACKUP_COPY_TO=
MYSQL_BIN=C:\xampp\mysql\bin

# لایسنس: کلید عمومی در config/license.php است؛ فقط برای آزمایش این‌جا عوض شود
# LICENSE_PUBLIC_KEY=
